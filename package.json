{
  "name": "@uralmash/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Дизайн-система «Уралмаш» — токены, примитивы и компоненты на React.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tslyme1/design-system.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && node scripts/strip-css-types.mjs",
    "prepare": "npm run build:lib",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "ds:lint": "node scripts/ds-lint.mjs src",
    "ds:stories": "node scripts/ds-stories-check.mjs src INVENTORY.md",
    "ds:check": "npm run ds:lint && npm run ds:stories"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.5.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20"
  }
}
