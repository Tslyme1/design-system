{
  /**
   * Типы для пакета. Отдельно от `tsconfig.json`, потому что тот проверяет всё
   * подряд — витрину, песочницу, истории, — а в пакет уходит только библиотека.
   *
   * Vite собирает JS, но не типы: декларации выпускает tsc, отсюда
   * `emitDeclarationOnly`. Отдельной зависимости для этого не нужно.
   */
  "extends": "./tsconfig.json",

  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },

  "include": ["src/index.ts", "src/tokens", "src/primitives", "src/components", "src/vite-env.d.ts"],
  "exclude": ["**/*.stories.tsx", "**/*.scene.module.css"]
}
